{
  "name": "pi-extensions",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "typecheck": "tsc -p tsconfig.tooling.json --noEmit && bun run --filter './packages/*' typecheck",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "bun test",
    "check:workspace": "bun scripts/check-workspace.ts",
    "test:boundaries": "bun test tests/tooling/boundaries.test.ts",
    "check": "bun run build && bun run check:workspace && bun run test:boundaries && bun run typecheck && bun run lint && bun test tests/tooling/workspace.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/bun": "1.2.22",
    "@types/node": "24.5.2",
    "@types/semver": "7.7.1",
    "eslint": "9.36.0",
    "prettier": "3.6.2",
    "semver": "7.7.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0"
  }
}
