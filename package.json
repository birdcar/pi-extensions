{
  "name": "pi-extensions",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "typecheck": "tsc -p tsconfig.tooling.json --noEmit && bun run --filter './packages/*' typecheck",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "bun test",
    "test:services": "bun test packages/services/test/discovery.test.ts",
    "test:write-for": "bun test packages/write-for/test/contract.test.ts packages/write-for/test/config.test.ts",
    "test:execution": "bun test packages/services/test/execution.test.ts",
    "test:pi": "bun run build && rm -rf .pi-tests && tsc -p tsconfig.pi-tests.json && mkdir -p .pi-tests/packages/services && cp -R packages/services/dist .pi-tests/packages/services/dist && cp packages/services/package.json .pi-tests/packages/services/package.json && node .pi-tests/tests/pi/lifecycle.js",
    "check:workspace": "bun scripts/check-workspace.ts",
    "check:package": "bun scripts/check-package.ts",
    "check:docs": "bun scripts/check-docs.ts",
    "test:boundaries": "bun test tests/tooling/boundaries.test.ts",
    "test:release": "bun test tests/release/manifest.test.ts",
    "test:release-lock": "bun test tests/release/lockfile.test.ts",
    "test:publish": "bun test tests/release/publish.test.ts",
    "test:ci": "bun test tests/release/workflows.test.ts tests/tooling/workspace.test.ts tests/tooling/docs.test.ts",
    "check": "bun run build && bun run check:workspace && bun run test:boundaries && bun run typecheck && bun run lint && bun run test:services && bun run test:write-for && bun run test:execution && bun run test:pi && bun run check:package && bun run test:release && bun run test:release-lock && bun run test:publish && bun run test:ci && bun run check:docs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@eslint/js": "9.36.0",
    "@types/bun": "1.2.22",
    "@types/node": "24.5.2",
    "@types/semver": "7.7.1",
    "eslint": "9.36.0",
    "prettier": "3.6.2",
    "release-please": "17.1.1",
    "semver": "7.7.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "yaml": "2.8.1"
  }
}
