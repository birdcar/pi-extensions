{
  "name": "@birdcar/pi-services",
  "version": "0.1.2",
  "description": "Portable service helpers for Pi extensions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birdcar/pi-extensions.git",
    "directory": "packages/services"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": false
}
