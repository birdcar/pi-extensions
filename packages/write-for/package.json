{
  "name": "@birdcar/pi-write-for",
  "version": "0.1.0",
  "description": "Pi extension foundation for writing in a selected voice and channel.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@birdcar/pi-services": "^0.1.0",
    "mammoth": "1.12.3",
    "typebox": "1.3.27",
    "unpdf": "1.8.1",
    "yaml": "2.8.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "sideEffects": false
}
